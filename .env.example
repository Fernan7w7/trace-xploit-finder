# Copy to ".env" (in this repo root) and fill in your key.
#
# API key for the LLM stages. The pipeline calls an OpenAI-compatible
# Chat Completions endpoint (https://api.openai.com/v1/chat/completions).
GPT_API_KEY=sk-your-key-here

# Optional: model id to use (default: gpt-4o-mini).
# A stronger model raises RECALL; precision stays ~1.0 by construction either way.
# D3_MODEL=gpt-4o
